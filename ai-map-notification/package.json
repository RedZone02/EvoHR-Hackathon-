{
  "name": "ai-map-notification",
  "version": "0.1.0",
  "private": true,
  "description": "Drop-in NestJS module: AI recommendations (Claude), proximity search and SSE notifications.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsc -p tsconfig.json && node dist/dev/smoke.js",
    "dev": "tsc -p tsconfig.json && node dist/dev/main.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "typescript": "~5.9"
  }
}
