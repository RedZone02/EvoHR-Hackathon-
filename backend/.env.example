# ==========================================
# SaveBite Backend - Environment Variables
# ==========================================

# Portul serverului NestJS
PORT=3000

# Mediu de rulare (development / production)
NODE_ENV=production

# Conexiunea MySQL (Nu folosiți SQLite - MySQL este cerința platformei)
# Format: mysql://UTILIZATOR:PAROLA@HOST:PORT/NUME_BAZA_DATE
DATABASE_URL="mysql://savebite_user:ParolaSigura2026!@localhost:3306/savebite_db"

# Secrete JWT (minim 32 caractere criptografice generate cu openssl rand -hex 32)
JWT_SECRET="savebite_jwt_super_secret_access_token_key_2026_at_least_32_chars!"
JWT_REFRESH_SECRET="savebite_jwt_super_secret_refresh_token_key_2026_at_least_32_chars!"

# Origini permise pentru CORS (separate prin virgulă)
# Pentru Cloudflare Pages, includeți domeniul *.pages.dev sau domeniul custom
CORS_ORIGIN="http://localhost:5173,http://127.0.0.1:5173,https://*.pages.dev,https://savebite.ro"

# Rate Limiting (Throttler)
THROTTLE_TTL=60000
THROTTLE_LIMIT=60

# AI, hartă și notificări (modulul ai-map-notification)
# Cheia Claude. Fără ea se folosesc mesaje-șablon (notificările merg oricum).
ANTHROPIC_API_KEY=
# Raza pentru notificări de proximitate, în metri
NOTIFY_RADIUS_M=1000
# Pauza minimă între două notificări pentru același client, în ms
NOTIFY_COOLDOWN_MS=120000
# 1 = dezactivează apelurile AI (doar șabloane)
AI_DISABLED=0
